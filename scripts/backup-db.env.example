# Template for ~/.scrumban-backup.env on the VM (NOT committed).
# Keep mode 600 since it contains static access keys.

# YC Object Storage bucket where dumps land
BACKUP_BUCKET=scrumban-backups

# Static access keys from a YC service account with storage.editor role
AWS_ACCESS_KEY_ID=YCAJExxxxxxxxxxxxxxx
AWS_SECRET_ACCESS_KEY=YCxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AWS_DEFAULT_REGION=ru-central1

# Optional: repo location on the host. Defaults to ~/scrumban_app.
# REPO_DIR=/home/_danya/scrumban_app

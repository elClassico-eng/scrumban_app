# Template for ~/.scrumban-backup.env on the prod host (NOT committed), mode 600.

# age public key of the person who can restore (age-keygen -y <private key file>).
# The private key never lives on a server.
AGE_RECIPIENT=age1REPLACE_ME

# healthchecks.io rejects HTTP pings from Russian IPs, so signals go by email
# to the check's address. Check filter: subject "OK" = success, "FAIL" = failure.
# The prod host only reports failures; the off-site puller reports success.
HC_PING_EMAIL=REPLACE_ME@hc-ping.com
SMTP_URL=smtps://mail.example.com:465
SMTP_USER=sender@example.com
SMTP_PASS='REPLACE_ME'

# Optional overrides.
# REPO_DIR=/home/deploy/scrumban_app
# BACKUP_DIR=/home/deploy/backups
# RETENTION_DAYS=14

# Cron (crontab -e as deploy), server time:
# 30 3 * * * /home/deploy/scrumban_app/scripts/backup-db.sh >> /home/deploy/backups/backup.log 2>&1

# Read-only access for the off-site puller, one line in ~/.ssh/authorized_keys:
# command="rrsync -ro /home/deploy/backups",restrict ssh-ed25519 AAAA... takt-backup-pull

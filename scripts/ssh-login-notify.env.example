# Template for /etc/ssh-login-notify.env (root, mode 600, NOT committed).
# Install:
#   install -m 755 -o root scripts/ssh-login-notify.sh /usr/local/sbin/ssh-login-notify
#   echo 'session optional pam_exec.so quiet /usr/local/sbin/ssh-login-notify' >> /etc/pam.d/sshd

# Where to send alerts.
ALERT_TO=you@example.com

# Env file with SMTP_URL / SMTP_USER / SMTP_PASS (reuse the backup config,
# e.g. /home/deploy/.scrumban-backup.env on prod, /root/.scrumban-pull.env off-site).
SMTP_ENV=/home/deploy/.scrumban-backup.env

# Space-separated user@ip pairs that do not trigger an alert (scheduled jobs).
SKIP_LOGINS="deploy@OFFSITE_BACKUP_IP"

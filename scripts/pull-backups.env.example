# Template for ~/.scrumban-pull.env on the off-site backup server (NOT committed), mode 600.

# Prod host account whose authorized_keys pins this key to `rrsync -ro ~/backups`.
SOURCE=deploy@PROD_HOST
SSH_KEY=/root/.ssh/takt-backup-pull

# Same healthchecks.io check and SMTP sender as on the prod host;
# this script sends the success signal.
HC_PING_EMAIL=REPLACE_ME@hc-ping.com
SMTP_URL=smtps://mail.example.com:465
SMTP_USER=sender@example.com
SMTP_PASS='REPLACE_ME'

# Optional overrides.
# DEST=/root/takt-backups
# RETENTION_DAYS=30
# MAX_AGE_HOURS=26

# Cron (crontab -e), an hour after the prod backup, server time (here UTC = MSK-3):
# 30 1 * * * /root/scrumban_app/scripts/pull-backups.sh >> /root/takt-backups/pull.log 2>&1

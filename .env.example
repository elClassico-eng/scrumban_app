# Runtime connection used by the app (scrumban_app role): non-superuser,
# non-bypass-RLS, DML-only.
DATABASE_URL=postgresql://scrumban_app:scrumban_app@localhost:5433/scrumban_dev

# Admin connection used for migrations and schema changes by drizzle-kit.
DATABASE_URL_ADMIN=postgresql://scrumban:scrumban@localhost:5433/scrumban_dev

# Session cookie signing key. Generate a random 32+ char string for prod.
NUXT_SESSION_PASSWORD=change-me-please-at-least-32-characters-long

LOG_LEVEL=info

# SMTP transport for transactional email (verification, password reset, invites).
# Dev defaults point to Mailpit (see docker-compose.dev.yml) — emails are caught
# at http://localhost:8025 and never leave the machine.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Scrumban <noreply@scrumban-thesis.ru>

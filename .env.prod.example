# Production env template — copy to .env on the server and fill in.
# The real .env stays only on the VM (gitignored), never committed.

# Domain Caddy will obtain a TLS cert for (Let's Encrypt).
DOMAIN=example.com

# Email used by Let's Encrypt for cert renewal notifications.
LETSENCRYPT_EMAIL=daniilerkesov122@gmail.com

# Postgres password for role `scrumban`. Generate with:
#   openssl rand -base64 32
POSTGRES_PASSWORD=REPLACE_ME_WITH_RANDOM_STRING

# Session cookie encryption key (≥32 chars). Generate with:
#   openssl rand -base64 48
NUXT_SESSION_PASSWORD=REPLACE_ME_WITH_RANDOM_STRING_OF_AT_LEAST_32_CHARS

# Sentry server-side error tracking. Leave empty to disable.
# Get DSN from https://sentry.io after creating a Node.js project.
SENTRY_DSN=

# Public URL used to build links in outbound emails. No trailing slash.
APP_URL=https://scrumban-thesis.ru

# Yandex Cloud Postbox via SES-compatible HTTP API (preferred on prod —
# YC Postbox doesn't expose SMTP-creds in CLI/UI for everyone yet).
# Use a service account static access key created in YC IAM
# (key_id = YCAJ..., secret = YCPM...). Service account needs role
# `postbox.editor` on the folder.
SES_ACCESS_KEY_ID=REPLACE_ME_WITH_YCAJ_KEY_ID
SES_SECRET_ACCESS_KEY=REPLACE_ME_WITH_YCPM_SECRET
SES_REGION=ru-central1
SES_ENDPOINT=https://postbox.cloud.yandex.net
SMTP_FROM=Scrumban <noreply@scrumban-thesis.ru>

# Inbox that receives landing lead-form submissions. Empty = leads are still
# saved to the DB, just no email notification is sent.
LEADS_NOTIFY_EMAIL=

# Comma-separated emails allowed to open /admin/leads. Empty = nobody has access.
ADMIN_EMAILS=

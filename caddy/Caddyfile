{
	email {$LETSENCRYPT_EMAIL}
}

{$DOMAIN} {
	encode gzip zstd

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
	}

	# HTML has no Cache-Control, so browsers cache it heuristically for hours and
	# keep loading hashed /_nuxt chunks that the next deploy has already removed.
	@pages not path /_nuxt/*
	header @pages ?Cache-Control "no-cache"

	reverse_proxy app:3000
}

scrumban-thesis.ru, www.scrumban-thesis.ru {
	redir https://{$DOMAIN}{uri} permanent
}
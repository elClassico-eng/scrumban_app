@startuml database
!theme plain
title ER-диаграмма БД Scrumban (PostgreSQL 16+)

skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam linetype ortho

' Легенда (условные обозначения) прямо на диаграмме
legend top left
|= Обозначение |= Значение |
| <b>PK</b> | Primary Key |
| <b>FK</b> | Foreign Key |
| <b>U</b>  | Unique |
| <b>I</b>  | Indexed |
| <b>*</b>  | NOT NULL |
| <b>o</b>  | Nullable |
| RLS       | Row-Level Security включён |
endlegend

' ============================================================================
' Identity & Tenancy
' ============================================================================

entity users {
  *<b>id</b> : uuid <<PK>>
  --
  *<b>email</b> : text <<U>>
  *password_hash : text
   name : text
   avatar_url : text
  *locale : text
  *created_at : timestamptz
   last_seen_at : timestamptz
   deleted_at : timestamptz
}

entity workspaces <<RLS: tenant root>> {
  *<b>id</b> : uuid <<PK>>
  --
  *name : text
  *<b>slug</b> : text <<U>>
  *plan : text
  *<b>owner_id</b> : uuid <<FK → users>>
  *settings : jsonb
  *created_at : timestamptz
   archived_at : timestamptz
}

entity workspace_members <<RLS>> {
  *<b>workspace_id</b> : uuid <<PK, FK>>
  *<b>user_id</b> : uuid <<PK, FK>>
  --
  *role : text
  *joined_at : timestamptz
  ..
  I (workspace_id, user_id)
}

entity invitations <<RLS>> {
  *<b>id</b> : uuid <<PK>>
  --
  *<b>workspace_id</b> : uuid <<FK, I>>
  *email : text
  *role : text
  *token_hash : text
  *expires_at : timestamptz
   invited_by : uuid <<FK → users>>
   accepted_at : timestamptz
  ..
  U (workspace_id, email) WHERE accepted_at IS NULL
}

entity sessions {
  *<b>id</b> : uuid <<PK>>
  --
  *<b>user_id</b> : uuid <<FK, I>>
  *<b>token_hash</b> : text <<U>>
  *expires_at : timestamptz
   user_agent : text
   ip : inet
  *created_at : timestamptz
   revoked_at : timestamptz
}

' ============================================================================
' Project & Board
' ============================================================================

entity projects <<RLS>> {
  *<b>id</b> : uuid <<PK>>
  --
  *<b>workspace_id</b> : uuid <<FK, I>>
  *name : text
  *<b>key</b> : text
   description : text
   created_by : uuid <<FK → users>>
   archived_at : timestamptz
  *created_at : timestamptz
  ..
  U (workspace_id, key)
}

entity boards <<RLS>> {
  *<b>id</b> : uuid <<PK>>
  --
  *<b>workspace_id</b> : uuid <<FK, I>>
  *<b>project_id</b> : uuid <<FK, I>>
  *name : text
  *type : text
  *created_at : timestamptz
}

entity columns <<RLS>> {
  *<b>id</b> : uuid <<PK>>
  --
  *<b>workspace_id</b> : uuid <<FK, I>>
  *<b>board_id</b> : uuid <<FK, I>>
  *name : text
  *order_index : int
   wip_limit : int
  *wip_strict : boolean
  *column_role : text
  *is_terminal : boolean
}

' ============================================================================
' Task & Sprint
' ============================================================================

entity tasks <<RLS>> {
  *<b>id</b> : uuid <<PK>>
  --
  *<b>workspace_id</b> : uuid <<FK, I>>
  *<b>project_id</b> : uuid <<FK, I>>
  *<b>board_id</b> : uuid <<FK>>
  *<b>column_id</b> : uuid <<FK, I>>
   sprint_id : uuid <<FK, I>>
  *short_id : text
  *title : text
   description : text
  *type : text
  *priority : text
   story_points : numeric
   estimate_hours : numeric
   assignee_id : uuid <<FK → users>>
  *reporter_id : uuid <<FK → users>>
  *created_at : timestamptz
  *updated_at : timestamptz
   closed_at : timestamptz
  *reopened_count : int
  ..
  U (workspace_id, project_id, short_id)
}

entity task_tags <<RLS>> {
  *<b>task_id</b> : uuid <<PK, FK>>
  *<b>tag</b> : varchar(64) <<PK>>
}

entity task_comments <<RLS>> {
  *<b>id</b> : uuid <<PK>>
  --
  *<b>workspace_id</b> : uuid <<FK, I>>
  *<b>task_id</b> : uuid <<FK, I>>
  *<b>author_id</b> : uuid <<FK → users>>
  *body : text
  *created_at : timestamptz
   updated_at : timestamptz
   deleted_at : timestamptz
}

entity task_attachments <<RLS>> {
  *<b>id</b> : uuid <<PK>>
  --
  *<b>workspace_id</b> : uuid <<FK, I>>
  *<b>task_id</b> : uuid <<FK, I>>
  *<b>uploaded_by</b> : uuid <<FK → users>>
  *object_key : text
  *filename : text
  *size_bytes : bigint
  *content_type : text
  *created_at : timestamptz
}

entity sprints <<RLS>> {
  *<b>id</b> : uuid <<PK>>
  --
  *<b>workspace_id</b> : uuid <<FK, I>>
  *<b>project_id</b> : uuid <<FK, I>>
  *name : text
   goal : text
   start_at : timestamptz
   planned_end_at : timestamptz
   closed_at : timestamptz
  *status : text
   created_by : uuid <<FK → users>>
  *created_at : timestamptz
}

' ============================================================================
' Events & Aggregates (для аналитики B и B+)
' ============================================================================

entity events <<RLS, append-only>> {
  *<b>id</b> : uuid <<PK>>
  --
  *<b>workspace_id</b> : uuid <<FK, I>>
  *occurred_at : timestamptz <<I>>
   actor_id : uuid <<FK → users>>
  *entity_type : text
  *entity_id : uuid
  *event_type : text
  *payload : jsonb
  ..
  I (workspace_id, occurred_at DESC)
  I (workspace_id, entity_type, entity_id, occurred_at)
  I (workspace_id, event_type, occurred_at)
}

entity flow_daily <<aggregate>> {
  *<b>workspace_id</b> : uuid <<PK>>
  *<b>project_id</b> : uuid <<PK>>
  *<b>date</b> : date <<PK>>
  *<b>column_id</b> : uuid <<PK>>
  --
  *count_in : int
  *count_out : int
  *count_eod : int
}

entity cycle_time_samples <<aggregate>> {
  *<b>id</b> : uuid <<PK>>
  --
  *<b>workspace_id</b> : uuid <<FK, I>>
  *<b>project_id</b> : uuid <<FK, I>>
  *<b>task_id</b> : uuid <<FK>>
  *<b>column_id</b> : uuid <<FK>>
  *column_role : text
  *entered_at : timestamptz
  *exited_at : timestamptz
  *duration_seconds : int
}

entity sprint_stats <<aggregate>> {
  *<b>workspace_id</b> : uuid <<FK>>
  *<b>sprint_id</b> : uuid <<PK, FK>>
  --
   planned_points : numeric
   completed_points : numeric
   rolled_over_points : numeric
   throughput_tasks : int
   avg_cycle_time_hours : numeric
  *computed_at : timestamptz
}

' ============================================================================
' Cross-cutting
' ============================================================================

entity feature_flags {
  *<b>name</b> : text <<PK>>
  --
  *enabled_globally : boolean
  *allowed_workspaces : uuid[]
   description : text
  *created_at : timestamptz
}

' ============================================================================
' Связи (cardinality в crow's foot notation)
' ||--    : one and only one
' }o--    : zero or many
' }|--    : one or many
' --o|    : zero or one
' ============================================================================

' Identity
users ||--o{ sessions
users ||--o{ workspace_members
workspaces ||--|{ workspace_members
workspaces ||--o{ invitations
users ||--o{ invitations

' Workspace → Project
workspaces ||--o{ projects
projects }o--|| users

' Project → Board → Column
projects ||--|| boards
boards ||--|{ columns

' Project → Sprint
projects ||--o{ sprints
sprints }o--o| users

' Task связи
projects ||--o{ tasks
boards ||--o{ tasks
columns ||--o{ tasks
sprints |o--o{ tasks
users |o--o{ tasks : "assignee"
users ||--o{ tasks : "reporter"

' Task вложенные
tasks ||--o{ task_tags
tasks ||--o{ task_comments
tasks ||--o{ task_attachments
users ||--o{ task_comments
users ||--o{ task_attachments

' Events — хвост, связан с workspace и опционально с актором
workspaces ||--o{ events
users |o--o{ events

' Aggregates (технические связи)
workspaces ||--o{ flow_daily
workspaces ||--o{ cycle_time_samples
tasks ||--o{ cycle_time_samples
sprints ||--|| sprint_stats

@enduml

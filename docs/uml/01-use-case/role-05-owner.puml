@startuml role-owner
!theme plain
title Use Case — Роль «Workspace Owner»

skinparam actorStyle awesome
skinparam packageStyle rectangle
skinparam defaultFontName Arial
skinparam defaultFontSize 11

left to right direction

actor "Workspace Owner" as Owner

rectangle "Scrumban Platform" {

    package "Жизненный цикл workspace (новое для Owner)" #E8F4FD {
        usecase "Создать workspace" as UC_CreateWS
        usecase "Настройки workspace" as UC_WSSettings
        usecase "Архивировать\nworkspace" as UC_ArchiveWS
    }

    package "Унаследовано от Admin" #F5F5F5 {
        usecase "Управление\nучастниками" as UC_Members
        usecase "Управление\nпроектами" as UC_Projects
    }

    package "Унаследовано от Scrum Master" #F5F5F5 {
        usecase "Управление спринтами" as UC_Sprints
        usecase "Углублённая аналитика" as UC_AdvAna
        usecase "Настройка доски" as UC_ConfigBoard
    }

    package "Унаследовано от Team Member" #F5F5F5 {
        usecase "Работа с задачами" as UC_Tasks
        usecase "Учётная запись" as UC_Account
    }

    package "Унаследовано от Viewer" #F5F5F5 {
        usecase "Просмотр и поиск" as UC_ViewAndSearch
        usecase "Базовая аналитика" as UC_BasicAna
    }
}

Owner --> UC_CreateWS
Owner --> UC_WSSettings
Owner --> UC_ArchiveWS
Owner --> UC_Members
Owner --> UC_Projects
Owner --> UC_Sprints
Owner --> UC_AdvAna
Owner --> UC_ConfigBoard
Owner --> UC_Tasks
Owner --> UC_Account
Owner --> UC_ViewAndSearch
Owner --> UC_BasicAna

note bottom of Owner
  <b>Workspace Owner</b> — создатель и высший
  администратор workspace'а. Обычно —
  руководитель команды или компании.
  Единственный может создавать / удалять workspace
  и менять биллинг (в Pro / Enterprise тарифах).
  Синий фон = добавлено к Admin.
end note

@enduml

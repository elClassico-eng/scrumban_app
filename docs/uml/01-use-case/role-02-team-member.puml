@startuml role-team-member
!theme plain
title Use Case — Роль «Team Member» (разработчик / тестировщик)

skinparam actorStyle awesome
skinparam packageStyle rectangle
skinparam defaultFontName Arial
skinparam defaultFontSize 11

left to right direction

actor "Team Member" as Member

rectangle "Scrumban Platform" {

    package "Учётная запись (новое для Member)" #E8F4FD {
        usecase "Регистрация\nаккаунта" as UC_Register
        usecase "Сброс пароля" as UC_ResetPwd
        usecase "Принять\nприглашение" as UC_AcceptInvite
    }

    package "Работа с задачами (новое для Member)" #E8F4FD {
        usecase "Создать задачу" as UC_CreateTask
        usecase "Назначить\nисполнителя" as UC_AssignTask
        usecase "Переместить\nзадачу" as UC_MoveTask
        usecase "Редактировать\nзадачу" as UC_EditTask
        usecase "Комментировать\nзадачу" as UC_CommentTask
        usecase "Прикрепить файл" as UC_AttachFile
    }

    package "Унаследовано от Viewer" #F5F5F5 {
        usecase "Вход / выход" as UC_Login
        usecase "Редактировать\nпрофиль" as UC_EditProfile
        usecase "Просмотр задачи" as UC_ViewTask
        usecase "Поиск и фильтрация" as UC_SearchTask
        usecase "Просмотр CFD" as UC_ViewCFD
        usecase "Throughput" as UC_ViewThroughput
    }
}

Member --> UC_Register
Member --> UC_ResetPwd
Member --> UC_AcceptInvite
Member --> UC_CreateTask
Member --> UC_AssignTask
Member --> UC_MoveTask
Member --> UC_EditTask
Member --> UC_CommentTask
Member --> UC_AttachFile
Member --> UC_Login
Member --> UC_EditProfile
Member --> UC_ViewTask
Member --> UC_SearchTask
Member --> UC_ViewCFD
Member --> UC_ViewThroughput

note bottom of Member
  <b>Team Member</b> — основной рабочий актёр:
  разработчик, тестировщик, аналитик.
  Работает с задачами ежедневно.
  Синий фон = <b>добавлено</b> к Viewer.
end note

@enduml

@startuml role-viewer
!theme plain
title Use Case — Роль «Viewer» (наблюдатель)

skinparam actorStyle awesome
skinparam packageStyle rectangle
skinparam defaultFontName Arial
skinparam defaultFontSize 11

left to right direction

actor "Viewer" as Viewer

rectangle "Scrumban Platform" {

    package "Учётная запись" {
        usecase "Вход / выход" as UC_Login
        usecase "Редактировать\nпрофиль" as UC_EditProfile
    }

    package "Задачи (только чтение)" {
        usecase "Просмотр задачи" as UC_ViewTask
        usecase "Поиск и фильтрация" as UC_SearchTask
    }

    package "Аналитика (базовая)" {
        usecase "Просмотр CFD" as UC_ViewCFD
        usecase "Throughput" as UC_ViewThroughput
    }
}

Viewer --> UC_Login
Viewer --> UC_EditProfile
Viewer --> UC_ViewTask
Viewer --> UC_SearchTask
Viewer --> UC_ViewCFD
Viewer --> UC_ViewThroughput

note bottom of Viewer
  <b>Viewer</b> — базовая роль, только <i>читает</i>.
  Примеры: внешний аудитор, представитель
  заказчика, guest-ревьюер.
end note

@enduml

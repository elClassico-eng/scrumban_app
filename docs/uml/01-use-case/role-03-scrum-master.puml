@startuml role-scrum-master
!theme plain
title Use Case — Роль «Scrum Master / Delivery Manager»

skinparam actorStyle awesome
skinparam packageStyle rectangle
skinparam defaultFontName Arial
skinparam defaultFontSize 11

left to right direction

actor "Scrum Master /\nDelivery Manager" as SM

rectangle "Scrumban Platform" {

    package "Спринты (новое для SM)" #E8F4FD {
        usecase "Создать спринт" as UC_CreateSprint
        usecase "Планировать\nспринт" as UC_PlanSprint
        usecase "Запустить спринт" as UC_StartSprint
        usecase "Закрыть спринт" as UC_CloseSprint
    }

    package "Доска (новое для SM)" #E8F4FD {
        usecase "Настроить колонки\nи WIP-лимиты" as UC_ConfigBoard
    }

    package "Углублённая аналитика (новое для SM)" #E8F4FD {
        usecase "Cycle time\nscatter" as UC_ViewScatter
        usecase "Monte Carlo\nпрогноз спринта" as UC_ViewMC
        usecase "WIP-рекомендация\n(Little's Law)" as UC_ViewWIPRec
        usecase "Сравнение\nспринтов" as UC_CompareSprints
        usecase "Bottleneck\nheatmap" as UC_ViewBottleneck
    }

    package "Унаследовано от Team Member" #F5F5F5 {
        usecase "Регистрация / вход / профиль" as UC_Base
        usecase "Работа с задачами\n(CRUD, комментарии, файлы)" as UC_Tasks
        usecase "Базовая аналитика\n(CFD, Throughput)" as UC_BasicAna
        usecase "Просмотр и поиск задач" as UC_ViewAndSearch
    }
}

SM --> UC_CreateSprint
SM --> UC_PlanSprint
SM --> UC_StartSprint
SM --> UC_CloseSprint
SM --> UC_ConfigBoard
SM --> UC_ViewScatter
SM --> UC_ViewMC
SM --> UC_ViewWIPRec
SM --> UC_CompareSprints
SM --> UC_ViewBottleneck
SM --> UC_Base
SM --> UC_Tasks
SM --> UC_BasicAna
SM --> UC_ViewAndSearch

note bottom of SM
  <b>Scrum Master / Delivery Manager</b> — primary persona продукта.
  Driver внедрения инструмента в команде.
  Работает со спринтами и углублённой аналитикой —
  <b>уникальные</b> фичи продукта (Monte Carlo, Little's Law).
  Синий фон = добавлено к Team Member.
end note

@enduml

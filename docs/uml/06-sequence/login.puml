@startuml login
!theme plain
title Сценарий «Вход пользователя» — диаграмма последовательности

skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam sequenceArrowThickness 1.5
skinparam roundCorner 6

actor "Пользователь" as User
participant "Browser\n(Nuxt SPA)" as Browser
participant "Caddy\n(reverse-proxy)" as Caddy
participant "HTTP API\n(echo)" as API
participant "AuthN\nMiddleware" as Auth
participant "Auth Service" as AuthSvc
participant "Storage\n(pgx+sqlc)" as Storage
database "PostgreSQL" as PG

== Ввод учётных данных ==
User -> Browser : Вводит email и пароль,\nклик «Войти»
Browser -> Browser : vee-validate:\nпроверка формата email,\nминимальной длины пароля

== Отправка запроса ==
Browser -> Caddy : POST /api/v1/auth/login\n{email, password}
Caddy -> API : HTTPS forward

== Обработка на сервере ==
API -> Auth : handler(c)
note right of Auth
  На login AuthN middleware
  пропускает без проверки cookie —
  сессии ещё нет.
end note

Auth -> AuthSvc : Login(ctx, email, password)

AuthSvc -> Storage : GetUserByEmail(email)
Storage -> PG : SELECT id, email,\npassword_hash\nFROM users\nWHERE email = $1
PG --> Storage : (id, email, password_hash)
Storage --> AuthSvc : User

alt Пользователь не найден или пароль неверен
  AuthSvc --> Auth : ErrInvalidCredentials
  Auth --> API : 401 Unauthorized
  API --> Caddy : {"error": "invalid_credentials"}
  Caddy --> Browser : 401
  Browser --> User : Показать ошибку\n«Неверный email или пароль»
else Пользователь найден
  AuthSvc -> AuthSvc : argon2id.Verify(password, hash)

  alt Пароль неверен
    AuthSvc --> Auth : ErrInvalidCredentials
    Auth --> API : 401 Unauthorized
    API --> Browser : 401
    Browser --> User : Ошибка
  else Пароль корректен
    AuthSvc -> AuthSvc : Генерация random\nsession token (256-bit)
    AuthSvc -> AuthSvc : Хэширование token\n(SHA-256)

    AuthSvc -> Storage : CreateSession(userId,\ntokenHash, UA, IP, expiresAt)
    Storage -> PG : INSERT INTO sessions\n(user_id, token_hash, ...)
    PG --> Storage : session_id
    Storage --> AuthSvc : Session

    AuthSvc --> Auth : (User, rawToken)

    Auth -> API : Set-Cookie:\nsession=<rawToken>;\nHttpOnly; Secure;\nSameSite=Lax; Max-Age=7d
    API --> Caddy : 200 OK\n{user: {...}}
    Caddy --> Browser : 200 + cookie

    Browser -> Browser : Pinia auth.setUser(user)
    Browser --> User : Redirect → /dashboard
  end
end

@enduml

@startuml package
!theme plain
title Package Diagram — модульная организация (Phase 1-3 MVP)

skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam packageStyle rectangle
skinparam package {
  BackgroundColor White
  BorderColor #1f2937
  ArrowColor #1f2937
}
skinparam component {
  BackgroundColor #f9fafb
  BorderColor #1f2937
}
skinparam note {
  BackgroundColor #fef3c7
  BorderColor #92400e
}

' ===== Frontend (skeleton) =====
package "app/ (Nuxt 4 frontend)" as app {
  component "app.vue" as app_root
  component "pages/index.vue" as app_pages

  note bottom of app
    Phase 1-3 MVP: только app.vue + pages/.
    components/, composables/, stores/ —
    появятся в Phase 4 (см. note справа).
  end note
}

' ===== Shared types =====
package "shared/types" as shared {
  component "auth.d.ts" as t_auth
  component "api.d.ts <<future>>" as t_api
}

' ===== Server tier =====
package "server/" as server {

  package "server/api (H3 file routing)" as api {
    package "auth/" as api_auth
    package "workspaces/[id]/" as api_ws {
      package "boards/[boardId]/" as api_boards {
        component "tasks/, columns/," as api_tasks
        component "sprints/, analytics/," as api_sprints
        component "stream.get.ts (SSE)" as api_stream
      }
      package "members/" as api_members
    }
    component "healthz.get.ts" as api_health
  }

  package "server/services" as services {
    component "tasks.service.ts" as svc_tasks
    component "sprints.service.ts" as svc_sprints
    component "analytics.service.ts" as svc_analytics
    component "boards.service.ts" as svc_boards
    component "columns.service.ts" as svc_columns
    component "workspaces.service.ts" as svc_workspaces
    component "workspace-members.service.ts" as svc_members
    component "users.service.ts" as svc_users
  }

  package "server/db/schema (Drizzle)" as schema {
    component "users.ts" as sch_users
    component "workspaces.ts\n(+ workspace_members)" as sch_ws
    component "boards.ts\n(+ board_columns)" as sch_boards
    component "tasks.ts\n(+ task_events)" as sch_tasks
    component "sprints.ts\n(+ sprint_tasks)" as sch_sprints
    component "index.ts" as sch_index
  }

  package "server/utils" as utils {
    component "auth.ts" as u_auth
    component "db.ts (withTenant)" as u_db
    component "errors.ts (5 domain errors)" as u_errors
    component "events.ts (in-process EventEmitter)" as u_events
    component "rbac.ts (5 ролей)" as u_rbac
  }
}

' ===== Persistence DDL =====
package "drizzle/migrations" as migrations {
  component "0000..0006_*.sql\n(7 миграций)" as mig_files
}

' ===== Tests =====
package "tests/" as tests {
  component "*.e2e.test.ts\n(11 файлов)" as t_e2e
  component "rls.integration.test.ts" as t_rls
  component "events.test.ts" as t_events
  component "helpers/" as t_helpers
}

' ===== External npm deps =====
package "External (npm)" as ext <<library>> {
  component "nuxt 4 + h3" as ext_nuxt
  component "drizzle-orm + drizzle-kit" as ext_drizzle
  component "nuxt-auth-utils\n(scrypt session cookies)" as ext_auth
  component "zod" as ext_zod
  component "vitest +\n@testcontainers/postgresql" as ext_test
  component "pino <<future>>\n(установлен, не подключён)" as ext_pino
}

' ===== Dependencies (acyclic, top-down) =====

' Frontend → shared types only
app ..> shared : "imports types"

' API layer → services + utils (auth/tenant guards in-handler)
api --> services : "вызывает бизнес-логику"
api --> utils : "auth + tenant guards\n(в обработчиках)"
api ..> ext_zod : "request validation"

' Services → schema + utils
services --> schema : "Drizzle queries\n(inline)"
services --> utils : "withTenant, errors,\nevents, rbac"

' Schema → drizzle ORM and migrations as DDL source
schema ..> ext_drizzle : "table builders"
schema ..> migrations : "DDL generated by\ndrizzle-kit"

' Utils external deps
u_auth ..> ext_auth : "requireUserSession"

' Nitro/H3 framework powers api layer
api ..> ext_nuxt : "defineEventHandler,\nfile routing"

' Tests cover everything
tests ..> server : "integration tests"
tests ..> schema : "RLS-isolation tests"
tests ..> ext_test : "vitest +\ntestcontainers"

' ===== Notes: Target packages =====
note as N1
  <b>Target пакеты — обоснованно отложены</b>
  (см. <code>../../08-backend-design.md</code> → Target):

  • <b>server/middleware/</b> — auth + tenant + rbac extraction.
    Триггер: ≥ 30 endpoint'ов с одинаковым guard-блоком.

  • <b>server/jobs/</b> — pg-boss workers.
    Триггер: первый async job (email / webhook /
    aggregate refresh / Monte Carlo precompute).

  • <b>server/db/queries/</b> — выделенный query-слой.
    Триггер: дедуп одного и того же SQL'а в ≥ 3 сервисах.

  • <b>openapi/scrumban.yaml</b> + <b>shared/types/api.d.ts</b> —
    zod-to-openapi → openapi-typescript codegen.
    Триггер: ≥ 5 endpoint-вызовов из app/.

  Frontend Phase 4 (см. <code>../../09-frontend-design.md</code>):
  app/components/, app/composables/, app/stores/ + полноценная
  навигация и экраны досок/задач.
end note

note as N2
  <b>Acyclic dependency claim:</b>

  Стрелки идут только сверху вниз —
  api → services → schema, и services → utils.

  Сервис никогда не импортирует обработчик;
  schema никогда не зависит от services;
  shared/ не зависит ни от server/, ни от app/.

  Это и есть «модульный монолит» —
  один артефакт, но границы слоёв
  заданы импортами, а не сетевыми вызовами.
end note

app -[hidden]down- shared
shared -[hidden]down- server
server -[hidden]down- N1
migrations -[hidden]right- tests
tests -[hidden]right- ext

@enduml
